{
	"name": "@arcadiasystems/morse-uploader",
	"version": "0.4.2",
	"description": "Headless-first React components and hooks for encrypted file sharing on Sui and Walrus, built on morse-sdk.",
	"license": "MIT",
	"author": "Arcadia Systems",
	"type": "module",
	"workspaces": [
		"examples/*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"sui",
		"walrus",
		"seal",
		"morse",
		"react",
		"file-upload",
		"uploader",
		"web3",
		"decentralized"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arcadiasystems/morse-uploader.git"
	},
	"homepage": "https://github.com/arcadiasystems/morse-uploader#readme",
	"bugs": {
		"url": "https://github.com/arcadiasystems/morse-uploader/issues"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./ui": {
			"types": "./dist/ui.d.ts",
			"import": "./dist/ui.js"
		},
		"./styles.css": "./dist/styles.css",
		"./wallet-standard": {
			"types": "./dist/wallet-standard.d.ts",
			"import": "./dist/wallet-standard.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"docs-gate": "bun scripts/docs-gate.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check:exports": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css",
		"build:example": "bun run build && cd examples/web && bun run build",
		"prepublishOnly": "bun run lint && bun run typecheck && bun run docs-gate && bun run test && bun run build && bun run check:exports"
	},
	"engines": {
		"node": ">=18.0.0",
		"bun": ">=1.2.0"
	},
	"peerDependencies": {
		"@arcadiasystems/morse-sdk": ">=0.9.0 <0.11.0",
		"@mysten/seal": ">=1.5.0 <1.5.1",
		"@mysten/sui": ">=2.36.0 <2.37.0",
		"@mysten/walrus": ">=1.2.35 <1.2.36",
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"@mysten/seal": {
			"optional": true
		},
		"@mysten/walrus": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arcadiasystems/morse-sdk": "0.10.0",
		"@arethetypeswrong/cli": "^0.18.1",
		"@biomejs/biome": "2.4.7",
		"@mysten/seal": "1.5.0",
		"@mysten/sui": "2.36.0",
		"@mysten/walrus": "1.2.35",
		"@testing-library/jest-dom": "^6.4.0",
		"@testing-library/react": "^16.0.0",
		"@testing-library/user-event": "^14.5.0",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"@vitest/coverage-v8": "^2.1.0",
		"jsdom": "^25.0.0",
		"publint": "^0.2.0",
		"react": "^18.3.0",
		"react-dom": "^18.3.0",
		"tsup": "^8.3.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	}
}
