{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@arcadiasystems/morse-uploader": ["../../dist/index.d.ts"],
			"@arcadiasystems/morse-uploader/ui": ["../../dist/ui.d.ts"],
			"@arcadiasystems/morse-uploader/wallet-standard": [
				"../../dist/wallet-standard.d.ts"
			]
		}
	},
	"include": ["src", "vite.config.ts"]
}
